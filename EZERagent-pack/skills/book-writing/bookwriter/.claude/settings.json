{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(node scripts/*)",
      "Bash(node scripts/pipeline/*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx *)",
      "Bash(typst compile *)",
      "Bash(typst --version)",
      "Bash(pandoc *)",
      "Bash(mmdc *)",
      "Bash(mkdir -p *)",
      "Bash(ls *)",
      "Bash(cp *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm *)",
      "Bash(git push *)",
      "Bash(npm publish *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/check-stage-gate.ps1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/verify-decisions.ps1"
          }
        ]
      }
    ]
  }
}
