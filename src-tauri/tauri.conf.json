{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZERagent",
  "version": "0.13.5",
  "identifier": "com.EZERagent.terminal",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "sh ../scripts/bundle-prep.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EZERagent — EZERagent Terminal",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/EZERagentd",
      "binaries/EZERagent"
    ],
    "resources": {
      "resources/pack.tar.gz": "./",
      "resources/pack-manifest.json": "./",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MDNFRUEwMTQ4OTk3NjMKUldSamw0a1VvTzRERnpnZWF4alBpWnl0ekNuVkRuazlNL2lFaHNIR3JFVFB3V200WisvQXNlcDkK",
      "endpoints": [
        "https://github.com/choijinyi/Ezer/releases/latest/download/latest.json"
      ]
    }
  }
}
